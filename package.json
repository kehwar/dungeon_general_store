{
  "name": "dungeon-general-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A cozy dungeon-town shop management game where you shape spawns as secret DM and guide delvers' fates",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@nuxt/image": "^1.8.1",
    "@pinia/nuxt": "^0.5.5",
    "@vueuse/nuxt": "^11.2.0",
    "firebase": "^11.0.2",
    "nuxt": "^4.2.1",
    "phaser": "^3.87.0",
    "pinia": "^2.2.6",
    "vue": "latest"
  },
  "devDependencies": {
    "@nuxt/eslint": "^0.5.7",
    "@nuxtjs/tailwindcss": "^6.12.2",
    "@vite-pwa/nuxt": "^0.10.5",
    "@vitest/ui": "^2.1.8",
    "eslint": "^9.15.0",
    "happy-dom": "^15.11.7",
    "playwright-core": "^1.49.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "vue-router": "^4.4.5",
    "vue-tsc": "^2.2.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}

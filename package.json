{
  "name": "dungeon-general-store",
  "version": "1.0.0",
  "description": "A minimalist, offline-first management game where you run a cozy dungeon-town shop, shape spawns as a secret DM, trade everything, and guide delvers' fates.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,vue,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,vue,js,json,md}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "nuxt": "^3.15.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@nuxt/eslint": "^0.7.4",
    "@nuxt/test-utils": "^3.15.4",
    "@vitest/ui": "^2.1.8",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^15.11.7",
    "prettier": "^3.7.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  },
  "keywords": [
    "game",
    "dungeon",
    "management",
    "offline-first",
    "pwa",
    "nuxt"
  ],
  "author": "",
  "license": "MIT"
}
